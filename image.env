# Build parameters for the kantainer image. Loaded by the Justfile.
# Upstream version pins live in versions.env, not here.
#
# IMAGE_REGISTRY/REPO_ORGANIZATION/IMAGE_NAME together are the ONE source of the
# published image reference. The build bakes that reference into the image's
# signing policy, and the publish workflow pushes to it. If the two ever named
# different things, machines would look up a scope that is not in their policy,
# fall through to the permissive transport default, and accept unsigned images.

IMAGE_NAME=kantainer
REPO_ORGANIZATION="point-source"
IMAGE_REGISTRY="ghcr.io"

IMAGE_DESC="uCore-based container host that boots straight into Docker with Portainer serving"
IMAGE_KEYWORDS="bootc,oci,linux,ucore,docker,portainer,container-host"

DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
