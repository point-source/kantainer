{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  // versions.env is not a format Renovate understands natively, but the Portainer
  // pin has to move: an untracked pin is how a machine stays on a version with a
  // known authentication bypass. Both halves of the pin are captured in one match
  // so Renovate rewrites the tag and the digest together - they must never drift.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": [
        "PORTAINER_IMAGE=(?<depName>.*?)\\nPORTAINER_TAG=(?<currentValue>.*?)\\nPORTAINER_DIGEST=(?<currentDigest>.*?)\\n",
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
    },
  ],

  "packageRules": [
    // Pinning action SHAs is mechanical and safe to land unattended.
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"],
    },

    // The base image is deliberately NOT automerged. Renovate rewrites the FROM
    // line in the Containerfile, but the same pin is also recorded in
    // versions.env for the installer half of the system, and Renovate does not
    // know about that file. `just ci` fails the pull request until a human
    // updates versions.env to match - which is the point, not an annoyance.
    {
      "matchFileNames": ["Containerfile"],
      "automerge": false,
      "addLabels": ["base-image"],
      "description": "Update versions.env in the same pull request, or `just ci` will fail.",
    },

    // Container references inside workflow files stay on their floating tags.
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ],
}
