#!/bin/bash
# Run Watchtower over the containers the operator deploys
# (SPEC.md §spec:container-updates).
#
# A script rather than a bare ExecStart= for the same reason portainer-run is
# one: the reasoning behind each flag sits where the next reader will look for
# it, and the reference comes from the file the build wrote.

set -oue pipefail

read -r IMAGE_REF < /usr/lib/kantainer/watchtower-image

# --security-opt label=type: opts this container into the domain that may hold
#     the Docker socket (selinux/kantainer_socket_client.te). Without it
#     Watchtower runs as container_t, which is every container on the machine and
#     deliberately has no route to the socket: it starts, fails its first API
#     call with "permission denied", and the only evidence is an AVC.
#
# --pull=never holds "never fetch this from a registry". docker run defaults to
#     --pull=missing, so if the image were removed from the store - an operator
#     running `docker system prune -a`, say - this line would otherwise quietly
#     fetch it from ghcr.io by tag, unsigned, bypassing the digest pinned in
#     versions.env. Failing here instead is the honest outcome; the load unit
#     cannot catch it, being a oneshot that stays active once it has run.
#
# --label ...watchtower.enable=false EXCLUDES WATCHTOWER FROM ITSELF, and it is
#     load-bearing. Watchtower updates its own container by default: it would
#     pull a newer Watchtower from ghcr.io and hand over to it, which breaks the
#     promise that the version running is the version versions.env recorded, and
#     leaves a container systemd did not start holding the Docker socket. This
#     Watchtower moves when the OS image moves, exactly like Portainer.
#
# No --restart flag and no published port: systemd owns this container's
# lifecycle, and Watchtower's optional HTTP API stays off.
#
# --cleanup removes the image a container was replaced from. Without it every
#     update leaves its predecessor behind, and this is a machine with one disk
#     that nobody is watching.
#
# --schedule runs at 05:00 rather than continuously. The six fields are
#     Watchtower's own cron dialect, seconds first.
#
#     THE HOUR IS CHOSEN, NOT ARBITRARY. The OS update window is 03:00 plus up to
#     an hour of jitter (bootc-fetch-apply-updates.timer.d/10-kantainer-overnight.conf),
#     and it ends by rebooting the machine. A reboot landing between Watchtower
#     stopping a container and recreating it leaves that container not merely
#     stopped but GONE - no restart policy brings back a container that no longer
#     exists. 05:00 keeps the whole of one window clear of the other.
#
#     It is UTC unless the machine's timezone has been changed, which Fedora
#     CoreOS does not do by default. /etc/localtime is deliberately not mounted:
#     files under /etc carry a label this domain cannot read, and widening the
#     policy module to fix a clock display is not a trade worth making.
#
# Nothing here limits WHICH containers are updated, so every container on the
# machine is in scope except the two carrying the exclusion label: this one and
# Portainer. An operator who wants a container left alone gives it the same
# label - docs/watchtower.md says how.
exec /usr/bin/docker run --rm --name kantainer-watchtower \
    --pull=never \
    --security-opt label=type:kantainer_socket_client_t \
    --label com.centurylinklabs.watchtower.enable=false \
    --volume /run/docker.sock:/var/run/docker.sock \
    "${IMAGE_REF}" \
    --cleanup \
    --schedule "0 0 5 * * *"
