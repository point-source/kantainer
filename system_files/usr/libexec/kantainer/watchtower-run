#!/bin/bash
# Run Watchtower over the containers the operator has labelled
# (SPEC.md §spec:container-updates).
#
# A script rather than a bare ExecStart= for the same reason portainer-run is
# one: the reasoning behind each flag sits where the next reader will look for
# it, and the reference comes from the file the build wrote.

set -oue pipefail

read -r IMAGE_REF < /usr/lib/kantainer/watchtower-image

# WHAT WATCHTOWER DOES IS DECIDED BY TWO ENV FILES, NOT BY THIS SCRIPT.
#
#   /usr/lib/kantainer/watchtower-defaults.env  the image's defaults: opt-in by
#                                               label, clean up, 05:00 UTC
#   /etc/kantainer/watchtower.env               the operator's overrides, if any
#
# Passed in that order, because Docker lets a later env file override an earlier
# one - verified against the pinned Watchtower, not assumed.
#
# DO NOT MOVE A DEFAULT ONTO THIS COMMAND LINE. It looks tidier and it silently
# breaks the override. Watchtower lets a flag win over its own environment
# variable, and Docker lets --env win over every --env-file whatever the order,
# so `--label-enable` here would make WATCHTOWER_LABEL_ENABLE=false in the
# operator's file do nothing at all - accepted, ignored, and never reported.
# scripts/test-watchtower.sh fails if a policy flag appears here.
#
# --env-file rather than systemd's EnvironmentFile=: this script's environment is
# not the container's. The Docker CLI reads both files here on the host and
# passes their contents in, so neither needs an SELinux label a container can
# read - unlike Portainer's password, which has to be staged into /run first.
#
# The operator's file is absent by default, and absent is the documented state.
# Passing --env-file for a file that does not exist is an error, hence the test.
DEFAULTS=/usr/lib/kantainer/watchtower-defaults.env
OPERATOR=/etc/kantainer/watchtower.env

env_files=(--env-file "${DEFAULTS}")
if [[ -f "${OPERATOR}" ]]; then
    env_files+=(--env-file "${OPERATOR}")
fi

# --security-opt label=type: opts this container into the domain that may hold
#     the Docker socket (selinux/kantainer_socket_client.te). Without it
#     Watchtower runs as container_t, which is every container on the machine and
#     deliberately has no route to the socket: it starts, fails its first API
#     call with "permission denied", and the only evidence is an AVC.
#
# --pull=never holds "never fetch this from a registry". docker run defaults to
#     --pull=missing, so if the image were removed from the store - an operator
#     running `docker system prune -a`, say - this line would otherwise quietly
#     fetch it from ghcr.io by tag, unsigned, bypassing the digest pinned in
#     versions.env. Failing here instead is the honest outcome; the load unit
#     cannot catch it, being a oneshot that stays active once it has run.
#
# --label ...watchtower.enable=false EXCLUDES WATCHTOWER FROM ITSELF. Under the
#     default opt-in scope it is redundant, and it stays anyway: the operator's
#     env file can switch opt-in off, and the moment it does this label is the
#     only thing standing between Watchtower and updating itself out of the
#     version versions.env pinned. portainer-run carries the same label for the
#     same reason.
#
#     This one IS a flag, and correctly so: it is a Docker label on the container,
#     not a Watchtower setting, and nothing an operator writes should remove it.
#
# No --restart flag and no published port: systemd owns this container's
# lifecycle, and Watchtower's optional HTTP API stays off.
exec /usr/bin/docker run --rm --name kantainer-watchtower \
    --pull=never \
    --security-opt label=type:kantainer_socket_client_t \
    --label com.centurylinklabs.watchtower.enable=false \
    --volume /run/docker.sock:/var/run/docker.sock \
    "${env_files[@]}" \
    "${IMAGE_REF}"
