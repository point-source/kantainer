[Unit]
Description=Show this machine's address and network on the login screen
Documentation=https://github.com/point-source/kantainer
After=NetworkManager.service

# Deliberately NOT Requires=NetworkManager.service. A machine whose network
# manager failed still has a login screen, and the honest thing to put on it is
# the no-address line - which is exactly what the generator writes when there is
# nothing to report. Refusing to run would leave the screen with whatever the
# last boot wrote instead.

# systemd's default start limit - five starts in ten seconds - applies to
# externally requested starts, not just Restart=. The dispatcher issues one
# restart per network event, and a single boot produces far more than five: an
# up and a dhcp4-change for each interface, plus docker0 and a bridge for every
# Portainer network the operator has defined. The sixth would be refused, the
# unit would go failed, and the screen would keep whatever the last successful
# run wrote - usually "no network address yet", because that is what the early
# ones write. Nothing would surface it: greenboot's default checks are
# deliberately not installed, so a failed unit does not fail the boot.
#
# Rate-limiting the one thing that keeps the display honest protects nothing.
# The work is a few nmcli calls and an atomic write.
StartLimitIntervalSec=0

[Service]
Type=oneshot

# No RemainAfterExit=yes, unlike this repository's other oneshot units. Those
# run once per boot; this one is restarted by the NetworkManager dispatcher
# every time a cable, a network or an address changes, and a unit left "active
# (exited)" would report the wrong thing about work that runs continuously.
ExecStart=/usr/libexec/kantainer/console-network-snippet

[Install]
WantedBy=multi-user.target
