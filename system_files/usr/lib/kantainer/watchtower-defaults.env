# Watchtower's defaults on this machine (SPEC.md §spec:container-updates).
#
# Passed to the container by watchtower-run with --env-file, BEFORE the
# operator's own /etc/kantainer/watchtower.env - and Docker lets a later env file
# override an earlier one, so anything set here can be changed there. That is
# why these are variables in a file and not flags on the command line:
# Watchtower lets a flag override its own environment variable, and Docker lets
# --env override every --env-file, so a default written either of those ways
# could not be changed by the operator at all. The override would be accepted,
# ignored, and never reported.
#
# FORMAT, because Docker's is stricter than it looks: KEY=value, value taken
# literally to the end of the line. No quotes - they would become part of the
# value. Comments only on lines of their own - a # after a value is part of it.

# Only containers labelled com.centurylinklabs.watchtower.enable=true are
# updated. A machine that switches Watchtower on changes nothing until the
# operator says which containers they meant.
WATCHTOWER_LABEL_ENABLE=true

# Delete the image a container was replaced from. This is a machine with one
# disk and nobody watching it fill.
WATCHTOWER_CLEANUP=true

# 05:00 UTC, in Watchtower's six-field cron dialect (seconds first). Clear of the
# OS update window, 03:00 plus up to an hour, which ends by rebooting: a reboot
# between Watchtower stopping a container and recreating it deletes that
# container outright. scripts/test-watchtower.sh fails if the two ever overlap.
WATCHTOWER_SCHEDULE=0 0 5 * * *
