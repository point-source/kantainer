# Pinned upstream versions. Both halves of the system are reproducible from this
# file (SPEC.md §spec:image-publication: "The versions the image depends on are
# pinned in the repository, so a rebuild is a rebuild rather than a fresh roll of
# the dice").
#
# Shell-sourceable KEY=value on purpose: the flash command sources this directly,
# and `just ci` cross-checks UCORE_* against the Containerfile's FROM line.
#
# UCORE_* is the base image this repository builds on.
# FCOS_*  is the Fedora CoreOS release the installer media is produced from
#         (SPEC.md §spec:installer-media). uCore ships no installer of its own.
#
# These two are deliberately kept in step: ucore-minimal:stable-20260904 is built
# from Fedora CoreOS 44.20260817.3.2, the same release pinned below. Keep them
# aligned when bumping — an installer and an image from different CoreOS releases
# will work, but nobody will enjoy debugging the day they don't.

UCORE_IMAGE=ghcr.io/ublue-os/ucore-minimal
UCORE_TAG=stable-20260904
UCORE_DIGEST=sha256:25b1f5a867c1e1272be0fec0e5523bc3395c409b1ddca5a9257d74b819f719b7

FCOS_STREAM=stable
FCOS_VERSION=44.20260817.3.2
FCOS_ISO_SHA256=2b2e639ba8aaafcaad36bb2047aa2f24dbdc7368a291509663540fa66029d7f9
