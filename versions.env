# Pinned upstream versions. Both halves of the system are reproducible from this
# file (SPEC.md §spec:image-publication: "The versions the image depends on are
# pinned in the repository, so a rebuild is a rebuild rather than a fresh roll of
# the dice").
#
# Shell-sourceable KEY=value on purpose: the flash command sources this directly,
# and `just ci` cross-checks UCORE_* against the Containerfile's FROM line.
#
# UCORE_* is the base image this repository builds on.
# FCOS_*  is the Fedora CoreOS release the installer media is produced from
#         (SPEC.md §spec:installer-media). uCore ships no installer of its own.
#
# These two are deliberately kept in step: ucore-minimal:stable-20260904 is built
# from Fedora CoreOS 44.20260817.3.2, the same release pinned below. Keep them
# aligned when bumping — an installer and an image from different CoreOS releases
# will work, but nobody will enjoy debugging the day they don't.

UCORE_IMAGE=ghcr.io/ublue-os/ucore-minimal
UCORE_TAG=stable-20260904
UCORE_DIGEST=sha256:25b1f5a867c1e1272be0fec0e5523bc3395c409b1ddca5a9257d74b819f719b7

FCOS_STREAM=stable
FCOS_VERSION=44.20260817.3.2
FCOS_ISO_SHA256=2b2e639ba8aaafcaad36bb2047aa2f24dbdc7368a291509663540fa66029d7f9

# PORTAINER_* is the container image the machine serves its web interface from
# (SPEC.md §spec:portainer-service). It is pulled at BUILD time and carried
# inside the OS image as an archive, so the machine never contacts a registry
# for it - a Docker Hub outage or rate limit cannot stop a freshly installed
# machine from serving.
#
# The digest is what is actually pulled; the tag is what a human reads and what
# names the image once Docker has loaded it. `:lts` and `:latest` both currently
# resolve here too, and both float - pin the numeric tag.
PORTAINER_IMAGE=docker.io/portainer/portainer-ce
PORTAINER_TAG=2.45.0
PORTAINER_DIGEST=sha256:511f3f06c96fe3b993ebeaafde311c1959cae73a7ef825dba6397d51b450dffa

# COREOS_INSTALLER_* is the tool `just flash` personalises the installer media
# with (SPEC.md §spec:installer-media). coreos-installer publishes no portable
# binary - only a source tarball and this container - so the flash command runs
# it through podman, which the Justfile already requires for image builds.
#
# Pinned by digest for the same reason as everything else here: the tool that
# writes the operator's account, key and password onto a USB stick is not one to
# take from a floating tag. The digest names a multi-architecture index, so
# podman still selects the right architecture for the operator's machine.
COREOS_INSTALLER_IMAGE=quay.io/coreos/coreos-installer
COREOS_INSTALLER_TAG=v0.26.0
COREOS_INSTALLER_DIGEST=sha256:2c94387e76ae351a4183f29707fd7be57a9290675524391bdb17b40de1e088ff
